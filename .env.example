# --- Required ---
OPENAI_API_KEY=your_openai_key_here
TAVILY_API_KEY=your_tavily_key_here

# --- Models (defaults shown; must match config.py and README) ---
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- Pipeline tuning ---
DEFAULT_COMPETITORS=Anthropic,Google,Meta,Mistral,Perplexity
MAX_SNIPPETS_PER_COMPETITOR=10
CONFIDENCE_THRESHOLD=0.6
MIN_SIGNALS_PER_COMPETITOR=2
MAX_RESEARCH_RETRIES=2
DEDUP_SIMILARITY_THRESHOLD=0.92
MEMORY_TOP_K=5

# --- Storage ---
DATA_DIR=./data
SQLITE_DB_PATH=./data/competeiq.db
CHROMA_PERSIST_DIR=./data/chroma

# --- Misc ---
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8000
